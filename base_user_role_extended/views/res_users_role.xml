<odoo>
    <record id="view_res_users_role_form_extend" model="ir.ui.view">
        <field name="name">res.users.role.form.extend</field>
        <field name="model">res.users.role</field>
        <field name="inherit_id" ref="base_user_role.view_res_users_role_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_internal_notes']" position="before">
                <page name="page_model_access" string="Model Access">
                    <div class="alert alert-info" role="alert">
                        <strong>Note:</strong>
                        Configure model-level access rights here. You can control
                        <b>Read</b>, <b>Write</b>, <b>Create</b>,
                        and <b>Delete</b> access for the selected model.
                    </div>
                    <field name="role_model_access_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="model_id" options="{'no_create': True}" />
                            <field name="perm_read" />
                            <field name="perm_write" />
                            <field name="perm_create" />
                            <field name="perm_unlink" />
                        </list>
                    </field>
                </page>
                <page name="model_operations" string="Model Operations">
                    <div class="alert alert-info" role="alert">
                        <strong>Note:</strong>
                        Configure model-level operation restrictions here. You can control
                        <b>Export</b>, <b>Import</b>, <b>Archive</b>, <b
                    >Report Actions</b>,
                        and <b>Button Actions</b> for the selected model.
                    </div>
                    <field name="role_model_operations_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="model_id" options="{'no_create': True}" />
                            <field name="perm_duplicate" />
                            <field name="perm_export" />
                            <field name="perm_import" />
                            <field name="perm_archive" />
                            <field
                                name="report_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                            />
                            <field
                                name="action_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                            />
                        </list>
                    </field>
                </page>
                <page string="Menu Items" id="menu_ids">
                    <div class="alert alert-info" role="alert">
                        <strong>Note:</strong>
                        Configure menu visibility restrictions for this role. Select the menus
                        that should be hidden from users assigned to this role.
                    </div>
                    <field name="menu_ids" context="{'ir.ui.menu.full_list': True}" />
                </page>

                <page string="View Access Rules" name="view_access_rules">
                    <div class="alert alert-info" role="alert">
                        <strong>Note:</strong>
                        Define view-level restrictions for fields, buttons, pages and other
                        view elements. Target elements can be specified using field names, button
                        definitions, or XPath expressions.
                    </div>
                    <field name="view_access_rule_ids">
                        <list editable="bottom">
                            <field name="sequence" />
                            <field name="model_id" />
                            <field name="model_name" column_invisible="1" />
                            <field name="view_id" />
                            <field name="view_xml_id" />
                            <field
                                name="view_type"
                                readonly="view_id != False"
                                force_save="1"
                            />
                            <field name="target_element_ui" />
                            <field name="resolved_element" column_invisible="1" />
                            <field name="rule_invisible" />
                            <field name="rule_readonly" />
                            <field name="rule_required" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
